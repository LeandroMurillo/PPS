		"@types/express": "^4.17.21",
		"@types/node": "^20.14.0",
		"eslint": "^9.16.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"tsx": "^4.19.0",
		"typescript": "^5.5.0",
		"typescript-eslint": "^8.60.0"
