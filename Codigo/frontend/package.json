		"@mui/icons-material": "^7",
		"@mui/material": "^7",
		"@mui/material-nextjs": "^7",
		"@toolpad/core": "^0.16.0",
		"@turf/boolean-point-in-polygon": "^7.3.5",
		"@turf/helpers": "^7.3.5",
		"@types/leaflet": "^1.9.21",
		"leaflet": "^1.9.4",
		"next": "^15.5.23",
		"postcss": "^8.5.26",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-leaflet": "^4.2.1",
		"react-router": "^7",
		"react-router-dom": "^7.17.0",
