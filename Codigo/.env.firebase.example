# Firebase Web SDK (configuración pública; Vite la incorpora durante el build)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mosaico-cultural-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mosaico-cultural-dev
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin SDK (secretos exclusivos del backend)
FIREBASE_PROJECT_ID=mosaico-cultural-dev
FIREBASE_CLIENT_EMAIL=
# En .env local, conservar los saltos de línea escapados como \n.
FIREBASE_PRIVATE_KEY=
